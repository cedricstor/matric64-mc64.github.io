def main():
    print("Running React App Health Check...\n")

    # Check project structure
    required_files = ["package.json", "src", "public"]
    for item in required_files:
        if not check_file_exists(item):
            print(f"❌ Missing: {item}")
        else:
            print(f"✅ Found: {item}")

    # Check Node and npm
    node_ok, node_version, npm_ok, npm_version = check_npm_and_node()
    if node_ok and npm_ok:
        print(f"✅ Node.js Version: {node_version}")
        print(f"✅ npm Version: {npm_version}")
    else:
        print("❌ Node.js or npm is not installed properly.")

    # Check package.json validity
    package_ok, package_data_or_message = check_package_json()
    if package_ok:
        print(f"✅ package.json is valid (App Name: {package_data_or_message['name']})")
    else:
        print(f"❌ {package_data_or_message}")

    # Check npm install
    print("\nRunning `npm install` to validate dependencies...")
    install_ok, install_stdout, install_stderr = run_command("npm install")
    if install_ok:
        print("✅ npm install completed successfully.")
    else:
        print(f"❌ npm install failed: {install_stderr}")

    # Check build folder
    if check_build_folder():
        print("✅ Build folder exists.")
    else:
        print("❌ Build folder missing. Run `npm run build` to create it.")

    # Check deployed site status
    deployed_ok, deployed_message = check_deployed_site(REPO_URL)
    if deployed_ok:
        print(f"✅ Deployment check: {deployed_message}")
    else:
        print(f"❌ Deployment check failed: {deployed_message}")

if __name__ == "__main__":
    main()
import os
import subprocess
import json

REPO_URL = "https://cedricstor.github.io/matric64-mc64.github.io"

def check_file_exists(file_path):
    return os.path.exists(file_path)

def run_command(command):
    try:
        result = subprocess.run(command, shell=True, capture_output=True, text=True)
        return result.returncode == 0, result.stdout, result.stderr
    except Exception as e:
        return False, str(e), ""

def check_npm_and_node():
    node_ok, node_version, _ = run_command("node --version")
    npm_ok, npm_version, _ = run_command("npm --version")
    return node_ok, node_version.strip(), npm_ok, npm_version.strip()

def check_package_json():
    package_path = "package.json"
    if not check_file_exists(package_path):
        return False, "package.json not found."
    
    try:
        with open(package_path, "r") as file:
            package_data = json.load(file)
        return True, package_data
    except json.JSONDecodeError:
        return False, "Invalid package.json format."

